---
import {
	getEmDashCollection,
	getTaxonomyTermsWithCacheHint,
} from "emdash";

const [articlesResult, categoriesResult] = await Promise.all([
	getEmDashCollection("articles", {
		status: "published",
		orderBy: { published_at: "desc" },
		limit: 5,
	}),
	getTaxonomyTermsWithCacheHint("category", { includeCounts: true }),
]);

if (Astro.cache?.enabled) {
	Astro.cache.set(articlesResult.cacheHint);
	Astro.cache.set(categoriesResult.cacheHint);
}
---

<aside class="news-sidebar">
	<section>
		<h2>Chuyên mục</h2>
		<ul class="category-list">
			{
				categoriesResult.data.map((category) => (
					<li>
						<a href={`/category/${category.slug}`}>
							<span>{category.label}</span>
							<span>{category.count ?? 0}</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section>
		<h2>Tin mới nhất</h2>
		<ol class="latest-list">
			{
				articlesResult.entries.map((article) => (
					<li><a href={`/articles/${article.id}`}>{article.data.title}</a></li>
				))
			}
		</ol>
	</section>
</aside>

<style>
	.news-sidebar { display: grid; gap: 2rem; }
	section { border-top: 4px solid var(--color-ink); padding-top: .8rem; }
	h2 { margin: 0 0 1rem; font-family: var(--font-display); font-size: 1.2rem; }
	ul, ol { margin: 0; padding: 0; list-style: none; }
	.category-list li { border-bottom: 1px solid var(--color-border); }
	.category-list a {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: .7rem 0;
		color: var(--color-ink);
		font-weight: 700;
		text-decoration: none;
	}
	.category-list a span:last-child { color: var(--color-muted); font-weight: 500; }
	.latest-list { counter-reset: news; }
	.latest-list li {
		display: grid;
		grid-template-columns: 2rem 1fr;
		gap: .5rem;
		padding: .75rem 0;
		border-bottom: 1px solid var(--color-border);
		counter-increment: news;
	}
	.latest-list li::before {
		content: counter(news, decimal-leading-zero);
		color: var(--color-accent);
		font-family: var(--font-display);
		font-weight: 800;
	}
	.latest-list a { color: var(--color-ink); font-weight: 700; text-decoration: none; }
	.latest-list a:hover, .category-list a:hover { color: var(--color-accent); }
</style>
