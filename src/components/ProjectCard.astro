---
import type { ContentEntry, InferCollectionData } from "emdash";
import { Image } from "emdash/ui";

interface Props {
	project: ContentEntry<InferCollectionData<"projects">>;
}

const { project } = Astro.props;
---

<article class="project-card">
	<a href={`/projects/${project.id}`}>
		<div {...project.edit.featured_image}>
			<Image image={project.data.featured_image} />
		</div>

		<h2 {...project.edit.title}>
			{project.data.title}
		</h2>
	</a>
</article>

<style>
	.project-card {
		overflow: hidden;
		border: 1px solid #ddd;
		border-radius: 12px;
		background: white;
	}

	.project-card a {
		color: inherit;
		text-decoration: none;
	}

	.project-card h2 {
		margin: 0;
		padding: 1rem;
	}

	.project-card :global(img) {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}
</style>