---
import { decodeSlug, getEmDashCollection, getTaxonomyTermsWithCacheHint } from "emdash";
import ArticleArchive from "../../components/ArticleArchive.astro";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("tag", { includeCounts: false });
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;
if (!term) return Astro.rewrite("/404");

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const result = await getEmDashCollection("articles", {
	status: "published",
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
	limit: 12,
	cursor,
});

if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(result.cacheHint);
}

const firstPageHref = cursor ? `/tag/${term.slug}` : undefined;
const nextPageHref = result.nextCursor
	? `/tag/${term.slug}?cursor=${encodeURIComponent(result.nextCursor)}`
	: undefined;
---

<ArticleArchive
	title={`#${term.label}`}
	eyebrow="Chủ đề"
	description={`Các bài viết gắn thẻ ${term.label}`}
	articles={result.entries}
	firstPageHref={firstPageHref}
	nextPageHref={nextPageHref}
/>
