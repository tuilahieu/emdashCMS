---
import {
	decodeSlug,
	getEmDashEntry,
	getSeoMeta,
	getSiteSettingsWithCacheHint,
} from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const [{ entry: page, cacheHint }, settingsResult] = await Promise.all([
	getEmDashEntry("pages", slug),
	getSiteSettingsWithCacheHint(),
]);
if (!page) return Astro.rewrite("/404");

if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(settingsResult.cacheHint);
}

const { siteTitle } = resolveStarterSiteIdentity(settingsResult.data);
const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<div class="container page-shell standard-page">
		<p class="eyebrow">Dòng Tin</p>
		<h1 class="page-heading" {...page.edit.title}>{page.data.title}</h1>
		<div class="prose" {...page.edit.content}>
			<PortableText value={page.data.content} />
		</div>
	</div>
</Base>

<style>
	.standard-page { max-width: 900px; }
</style>
