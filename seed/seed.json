        "id": "article-city-transit",
        "slug": "thanh-pho-mo-rong-giao-thong-cong-cong",
        "status": "published",
        "data": {
          "title": "Thành phố mở rộng mạng lưới giao thông công cộng",
          "excerpt": "Các tuyến kết nối mới hướng tới giảm thời gian di chuyển và tạo thêm lựa chọn cho người dân.",
          "content": [
            {
              "_type": "block",
              "_key": "transit-lead",
              "style": "normal",
              "children": [{ "_type": "span", "_key": "transit-lead-text", "text": "Kế hoạch mở rộng mạng lưới giao thông công cộng tập trung vào các khu vực có tốc độ đô thị hóa nhanh và nhu cầu đi lại lớn." }]
            },
            {
              "_type": "block",
              "_key": "transit-heading",
              "style": "h2",
              "children": [{ "_type": "span", "_key": "transit-heading-text", "text": "Ưu tiên khả năng kết nối" }]
            },
            {
              "_type": "block",
              "_key": "transit-body",
              "style": "normal",
              "children": [{ "_type": "span", "_key": "transit-body-text", "text": "Các điểm trung chuyển sẽ được bố trí gần khu dân cư, trường học và bệnh viện. Cơ quan quản lý cho biết sẽ tiếp tục lấy ý kiến cộng đồng trước khi hoàn thiện lộ trình." }]
            }
          ],
          "is_breaking": true,
          "is_featured": true,
          "location": "TP.HCM"
        },
        "bylines": [{ "byline": "byline-newsroom" }],
        "taxonomies": { "category": ["thoi-su"], "region": ["viet-nam"], "tag": ["moi-truong"] }
      },
