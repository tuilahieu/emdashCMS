            },
            {
              "_type": "block",
              "_key": "market-body",
              "style": "normal",
              "children": [{ "_type": "span", "_key": "market-body-text", "text": "Các chuyên gia nhận định dữ liệu minh bạch và năng lực thích ứng sẽ là lợi thế cạnh tranh quan trọng trong giai đoạn tiếp theo." }]
            }
          ],
          "is_breaking": false,
          "is_featured": true,
          "location": "Hà Nội"
        },
        "bylines": [{ "byline": "byline-economy" }],
        "taxonomies": { "category": ["kinh-te"], "region": ["viet-nam"], "tag": ["thi-truong", "moi-truong"] }
      },
      {
